# The Compose PostgreSQL container stores its data in the named postgres-data volume.
# Generate POSTGRES_PASSWORD as 64 hexadecimal characters so DATABASE_URL stays URL-safe.
POSTGRES_DB=cfi_pos
POSTGRES_USER=cfi_pos_app
POSTGRES_PASSWORD=

# Optional override when intentionally connecting the Compose API to external PostgreSQL.
# Do not set this for the bundled PostgreSQL container.
# DATABASE_URL=
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000

# Generate and set two independent random values before starting the application.
JWT_SECRET=
ENCRYPTION_KEY=

# The exact browser-visible origin, without a trailing slash.
PUBLIC_ORIGIN=http://localhost:8080
HTTP_PORT=8080

# Cookie Configuration (Deployment Shapes A & B)
# COOKIE_DOMAIN=
# COOKIE_SAMESITE=strict

# Optional initial-admin overrides; leave unset to use the existing application defaults.
# DEFAULT_ADMIN_EMAIL=
# DEFAULT_ADMIN_PASSWORD=

# Required for production login OTPs. Configure a Resend API key and verified sender.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional integrations. Set only the providers used by this deployment.
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# MPESA_API_BASE_URL=
# MPESA_CALLBACK_URL=
# MPESA_C2B_CALLBACK_BASE_URL=
# MPESA_C2B_CALLBACK_TOKEN=
# PESAPAL_SECRET=
# PESAPAL_API_SECRET=
# PESAPAL_IPN_SECRET=
# PESAPAL_MOCK_IFRAME_URL=
# ETIMS_QR_VERIFY_URL=
# ETIMS_CREDIT_NOTE_QR_VERIFY_URL=
ETIMS_MODE=off
# SENTRY_DSN=
ENABLE_PESAPAL_PAYMENTS=false
# GEMINI_API_KEY=
# AI_GATEWAY_URL=
# AI_MODEL=
