# PostgreSQL must already have the application schema. Use a dedicated application
# database, TLS where supported, and a role limited to the permissions the app needs.
DATABASE_URL=

# Generate and set two independent random values before starting the application.
JWT_SECRET=
ENCRYPTION_KEY=

# The exact browser-visible origin, without a trailing slash.
PUBLIC_ORIGIN=http://localhost:8080
HTTP_PORT=8080

# These values are public client configuration and are embedded in the frontend build.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional initial-admin overrides; leave unset to use the existing application defaults.
# DEFAULT_ADMIN_EMAIL=
# DEFAULT_ADMIN_PASSWORD=

# Optional integrations. Set only the providers used by this deployment.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# MPESA_API_BASE_URL=
# MPESA_CALLBACK_URL=
# MPESA_C2B_CALLBACK_BASE_URL=
# MPESA_C2B_CALLBACK_TOKEN=
# PESAPAL_SECRET=
# PESAPAL_API_SECRET=
# PESAPAL_IPN_SECRET=
# PESAPAL_MOCK_IFRAME_URL=
# ETIMS_QR_VERIFY_URL=
# ETIMS_CREDIT_NOTE_QR_VERIFY_URL=
# GEMINI_API_KEY=
# AI_GATEWAY_URL=
# AI_MODEL=
