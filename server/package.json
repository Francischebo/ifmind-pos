{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node --require ts-node/register --test src/controllers/PaymentController.test.ts src/data-source.test.ts",
    "test:integration": "node scripts/run-integration.cjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:bootstrap": "ts-node src/bootstrap.ts",
    "db:bootstrap:docker": "node dist/bootstrap.js",
    "migration:show": "typeorm-ts-node-commonjs -d src/data-source.ts migration:show",
    "migration:show:docker": "typeorm -d dist/data-source.js migration:show",
    "migration:run": "typeorm-ts-node-commonjs -d src/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/data-source.ts migration:revert",
    "migration:run:docker": "typeorm -d dist/data-source.js migration:run",
    "migration:revert:docker": "typeorm -d dist/data-source.js migration:revert",
    "dev": "node --watch --require ts-node/register src/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "read-excel-file": "^9.3.10",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.10.0",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^25.5.2",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/socket.io": "^3.0.1",
    "fflate": "^0.8.3",
    "socket.io-client": "^4.8.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}
