# PostgreSQL Database connection URL
# In production, use managed secrets (e.g., AWS Secrets Manager, Doppler, Vault, Docker/Kubernetes secrets)
DATABASE_URL="postgresql://pos_app_user:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/pos_db"

# Backend server port
PORT=3000

# CORS Allowed Origins (comma-separated list of browser-visible frontend URLs)
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080"

# Application Encryption Key: 64 hexadecimal characters (32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit or reuse this key across staging and production
ENCRYPTION_KEY="REPLACE_WITH_UNIQUE_64_CHAR_HEXADECIMAL_KEY"

# JWT Secret: At least 32 characters, preferably 64 hexadecimal characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER use known default values in production
JWT_SECRET="REPLACE_WITH_UNIQUE_64_CHAR_HEXADECIMAL_JWT_SECRET"

# Default Admin Setup (Optional bootstrap credentials for initial install)
# In production, provide a strong, unique password (min 12 characters) via a secret manager,
# or bootstrap without these variables and provision staff via the database.
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD="REPLACE_WITH_STRONG_UNIQUE_ADMIN_PASSWORD"

# Email Delivery Configuration (Resend)
# Required for sending two-factor authentication (OTP) emails
RESEND_API_KEY="REPLACE_WITH_RESEND_API_KEY"
RESEND_FROM_EMAIL="Molabs POS <notifications@yourdomain.com>"

# Integration Providers (Optional - populate only if enabled)
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_API_BASE_URL="https://api.safaricom.co.ke"
MPESA_CALLBACK_URL=""
PESAPAL_IPN_SECRET=""
AI_GATEWAY_URL="https://ai.gateway.lovable.dev/v1/chat/completions"
AI_MODEL="google/gemini-2.5-flash"
